{
  "name": "fitness-apps",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo of fitness apps built on the exercises-dataset",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "sync-data": "npm run sync-data --workspace @fitness-apps/exercise-data",
    "check": "turbo run check",
    "test": "turbo run test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "turbo": "^2.10.8",
    "typescript": "^5.6.0"
  }
}
