{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "check": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "env": [
        "SUPABASE_TEST_URL",
        "SUPABASE_TEST_ANON_KEY",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_PUBLISHABLE_KEY"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "size": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
